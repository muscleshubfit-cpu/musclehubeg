# =====================================================================
#  MuscleHubEG — Environment variables
#  Copy this file to `.env.local` for local dev, or set the same keys
#  in your Vercel project settings → Environment Variables.
# =====================================================================

# --- Supabase (required for production auth + data) ---
# Find these in your Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# When the two keys above are missing, the app runs in a local-only
# "demo mode" backed by localStorage — useful for previews & testing.
# Two demo accounts are auto-seeded in demo mode:
#   coach@coach.app  /  coach123   (logs in as the coach)
#   client@demo.app  /  client123  (logs in as a demo client)


# =====================================================================
#  AI Content Assistant (Blog CMS)
# =====================================================================
#
#  The AI Assistant works with any OpenAI-compatible provider.
#  Set the variables below for the default provider. Switching providers
#  never requires a deploy — just update AI_PROVIDER + the matching key.

# Which provider to use by default:
#   openrouter | openai | gemini | anthropic | groq | deepseek
AI_PROVIDER=openrouter

# Default model for the chosen provider
# (OpenRouter examples: anthropic/claude-3.5-sonnet, openai/gpt-4o-mini)
AI_MODEL=anthropic/claude-3.5-sonnet

# Default base URL (auto-filled per provider; only override if you use
# a custom OpenAI-compatible endpoint, e.g. Azure OpenAI or a proxy).
# AI_BASE_URL=https://openrouter.ai/api/v1

# API key for the chosen provider — set the matching one for your choice.
# If AI_PROVIDER isn't set, OPENROUTER_API is used as the default.
OPENROUTER_API=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# (Optional) Generic key used as a last-resort fallback if the
# provider-specific key isn't set.
# AI_API_KEY=

# --- Blog external research ---
# External research (for AI-generated blog articles) uses Google Gemini
# via @google/genai SDK with Google Search grounding. Set GEMINI_API_KEY
# (above) — no separate research-specific env vars are required.
# See DEVELOPER_GUIDE.md § 7 (Blog system) for the model fallback chain.

# --- PayPal (Primary Payment Method) ---
# Sandbox mode is used for development. Live mode will be enabled later.
#
# SECURITY:
# - PAYPAL_CLIENT_SECRET is SERVER-ONLY. Never prefix with NEXT_PUBLIC_.
# - PAYPAL_CLIENT_ID is also server-only (used for server-side Order API).
# - NEXT_PUBLIC_PAYPAL_CLIENT_ID is the PUBLIC client ID used by the
#   PayPal JS SDK in the browser (safe to expose — PayPal's design).
#
# Obtain these from: https://developer.paypal.com/dashboard/applications/sandbox
# Create a Sandbox app → get Client ID + Secret + Webhook ID.
#
# Set these in Vercel → Project Settings → Environment Variables.
# Do NOT commit real Sandbox or Live credentials to Git.

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
