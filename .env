# =====================================================================
#  MuscleHubEG — Environment variables
# =====================================================================

# Prisma local DB
DATABASE_URL=file:/home/z/my-project/db/custom.db

# --- Supabase (set these in production via Vercel project settings) ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# =====================================================================
#  AI Content Assistant (Blog CMS)
#  Gemini is the PRIMARY provider. You can switch providers any time
#  in /admin/ai-settings without code changes — these env vars are just
#  the default fallback when no override cookie is set.
# =====================================================================

# Default provider: openrouter | openai | gemini | anthropic | groq | deepseek
AI_PROVIDER=gemini

# Default model — Gemini 2.0 Flash (fast, multimodal, generous free tier).
# Other Gemini options:
#   - gemini-2.5-flash          (newer, smarter, still fast)
#   - gemini-2.5-pro            (most capable, slower)
#   - gemini-1.5-flash          (legacy, still works)
AI_MODEL=gemini-2.0-flash

# --- Provider API keys ---
# Google Gemini (PRIMARY) — https://aistudio.google.com/apikey
GEMINI_API_KEY=AQ.Ab8RN6IBNg5M9ShfZxhYq_0SmmEZByv1AnSaSRUuZMyrVQUnaQ

# OpenRouter (fallback) — https://openrouter.ai/keys
OPENROUTER_API_KEY=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

# Groq (ultra-fast fallback) — https://console.groq.com/keys
GROQ_API_KEY=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

# (Optional — add these later if needed)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
